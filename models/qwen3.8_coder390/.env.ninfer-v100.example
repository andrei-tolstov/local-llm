# ==============================================================================
# Переменные окружения для запуска JimmyMax/ninfer-v100 на Tesla V100 32GB
# Репозиторий: https://github.com/JimmyMax/ninfer-v100
# Архитектура: Volta (sm_70), CUDA 12.8
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (по умолчанию 8084)
CODER390_PORT=8084

# Имя контейнера (по умолчанию совпадает с llama-swap: coder390-llama-server)
CONTAINER_NAME=coder390-llama-server

# Идентификатор GPU для изоляции (Tesla V100 32GB)
# КРИТИЧЕСКИ ВАЖНО: Pascal GTX 1060 не должна быть доступна контейнеру
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
CODER390_MODELS_DIR=/opt/models/coder390

# Основной файл модели (символическая ссылка или имя .ninfer)
CODER390_MODEL_FILE=model_v100.ninfer

# Имя модели для OpenAI API / OmniRoute / Llama-swap
CODER390_ALIAS=coder390-27b
CODER390_API_KEY=

# ------------------------------------------------------------------------------
# Рекомендованные параметры JimmyMax/ninfer-v100:
# ------------------------------------------------------------------------------

# Логический потолок контекста (200000 по умолчанию в README, либо 260096)
CODER390_MAX_CONTEXT=200000

# Автоматическое распределение VRAM под KV кэш
CODER390_KV_CAPACITY=auto

# Тип данных KV кэша (int8)
CODER390_KV_DTYPE=int8

# Размер чанка префилла для Volta sm_70
CODER390_PREFILL_CHUNK=2048

# Количество параллельных запросов
CODER390_MAX_CONCURRENCY=1

# Спекулятивное декодирование:
# В JimmyMax/ninfer-v100 для Qwen3.8-27B на V100 рекомендовано 4 драфт-токена
CODER390_SPEC_BACKEND=mtp
CODER390_SPEC_DRAFT_TOKENS=4

# Ключевая рекомендация репозитория: отключение n-gram драфтов,
# предотвращающее размывание acceptance rate MTP (ускорение до 78.3 tok/s)
CODER390_NGRAM_DRAFT_TOKENS=0

# Сохранение блока рассуждений (thinking tokens)
CODER390_PRESERVE_THINKING=true

# Мультимодальность (Vision)
CODER390_ENABLE_VISION=true

# Таймаут ожидания очереди/подготовки запроса (в мс): 20 минут = 1200000 мс
CODER390_PENDING_TIMEOUT_MS=1200000

# Опциональные слоты состояния (оставьте пустыми для авто-режима гибридного кэша)
CODER390_DEVICE_STATE_SLOTS=
CODER390_HOST_STATE_SLOTS=
CODER390_HOST_KV_MIB=

# Дополнительные аргументы командной строки ninfer-serve (если требуются)
CODER390_EXTRA_ARGS=

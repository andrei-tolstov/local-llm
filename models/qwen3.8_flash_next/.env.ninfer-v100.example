# ==============================================================================
# Переменные окружения для запуска Qwen3.8-Flash-Next MoE (IQ3_S) на Tesla V100 32GB
# Репозиторий движка: https://github.com/JimmyMax/ninfer-v100
# Архитектура: Volta (sm_70), CUDA 12.8
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8087)
FLASH_NEXT_PORT=8087

# Имя контейнера (для интеграции с llama-swap: flash-next-llama-server)
CONTAINER_NAME=flash-next-llama-server

# Имя Docker-образа и Dockerfile движка (форк andrei-tolstov/ninfer-v100 feat/e5-2650v2-avx-support)
IMAGE_NAME=ninfer-v100:e5-2650v2-avx
DOCKERFILE=Dockerfile.ninfer-v100-avx

# Идентификатор GPU для изоляции (Tesla V100 32GB)
# КРИТИЧЕСКИ ВАЖНО: Pascal GTX 1060 не должна быть доступна контейнеру
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
FLASH_NEXT_MODELS_DIR=/opt/models/flash_next

# Файлы модели и companion n-gram таблицы
FLASH_NEXT_MODEL_FILE=Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-ninfer-v3.ninfer
FLASH_NEXT_NGRAM_FILE=Qwen3.8-Flash-Next-ngram-table-IQ4_NL-ninfer-v3.ninfer

# Имя модели для OpenAI API / OmniRoute / Llama-swap
FLASH_NEXT_ALIAS=qwen3.8-flash-next
FLASH_NEXT_API_KEY=

# ------------------------------------------------------------------------------
# Рекомендованные параметры JimmyMax/ninfer-v100:
# ------------------------------------------------------------------------------

# Логический потолок контекста (200000 токенов; или 32768 для увеличения кэша экспертов)
FLASH_NEXT_MAX_CONTEXT=200000

# Емкость KV кэша (auto выделяет оптимальный объем под контекст)
FLASH_NEXT_KV_CAPACITY=auto

# Квантование KV кэша и GDN recurrent state (rk4v4 экономит 1.2 GiB VRAM при расхождении всего +0.04% перплексии)
FLASH_NEXT_KV_DTYPE=rk4v4

# Режим хранения экспертов: disk (NVMe paging) или host (pinned RAM).
# host выбран осознанно: RAM хоста 125 GiB, RSS процесса ~81 GiB (замер 2026-11-22)
FLASH_NEXT_EXPERT_RESIDENCY=host

# Размер кэша экспертов в VRAM (в MiB). Дефицит промахов: 447k промахов => 1.41 TB через PCIe 3.0 за 276 с
FLASH_NEXT_EXPERT_CACHE_MIB=18432

# Чтение n-gram таблицы: disk (потоковое чтение по 16 строк на токен с диска),
# ram (вся таблица ~27.5GB в RAM), ram-hot (горячие строки в RAM, остальное с диска).
# Значение "host" движком НЕ поддерживается (exit 1: must be disk, ram or ram-hot).
# ram: p50 чтения строки 32 мкс, p99 2.05 мс, 2052 stall (замер 2026-11-22)
FLASH_NEXT_NGRAM_RESIDENCY=ram

# Буферизация префилла (только expert-residency=host): допустимо 1|2 (по умолчанию 1).
# 5000 движком НЕ принимается. 2 = копировать экспертов следующего слоя во время вычисления текущего
FLASH_NEXT_EXPERT_PREFILL_BUFFERS=2

# Доля вычислений экспертов на GPU: допустимы конечные числа 0..1 или auto (валидатор бинарника).
# 0.85 принято постоянным значением по замеру 23.11 (лестница 0.95->0.50, 12 этапов, ошибок 0):
# ниже 0.85 decode падает (38.6 -> 31.5 tok/s на 0.50), плато 0.80-0.90 = уровень 1.0 в пределах шума.
# --expert-cpu-arithmetic ggml не включать: на E5-2650 v2 без AVX2 TTFT 60k ухудшается до 3m33s.
FLASH_NEXT_EXPERT_DMA_SHARE=0.85

# Размер чанка префилла: help движка просит 4096 при native MoE experts в host-памяти
FLASH_NEXT_PREFILL_CHUNK=2048

# Количество параллельных запросов
FLASH_NEXT_MAX_CONCURRENCY=1

# Спекулятивное декодирование MTP:
# В JimmyMax/ninfer-v100 для Flash-Next MoE на V100 финальный оптимум - 3 драфт-токена (43.5-44.0 tok/s, 62.5% acceptance)
FLASH_NEXT_SPEC_BACKEND=mtp
FLASH_NEXT_SPEC_DRAFT_TOKENS=3

# Отключение n-gram драфтов, предотвращающее размывание acceptance rate MTP
FLASH_NEXT_NGRAM_DRAFT_TOKENS=0

# Сохранение блока рассуждений (thinking tokens)
FLASH_NEXT_PRESERVE_THINKING=true

# Мультимодальность (Vision tower)
FLASH_NEXT_ENABLE_VISION=true

# Таймаут ожидания очереди/подготовки запроса (в мс): 20 минут = 1200000 мс
FLASH_NEXT_PENDING_TIMEOUT_MS=1200000

# Дополнительные аргументы командной строки ninfer-serve (launch.sh эти флаги не маппит):
#  fast-prefill-kernel — быстрый prompt-attention для rk* KV: префилл 331 -> 1.02k tok/s (замер 2026-11-22)
#  adaptive-mtp — ширина проверки по выживаемости драфтов, greedy output не меняется
#  lm-head-q6 + embedding-q6 — задел под VRAM для экспертного кэша (+0.01% перплексии; на этом артефакте веса не изменились)
#  gdn-state-fp16 — вдвое меньше каждый host-образ рекуррентного состояния
#  ngram-lock — фиксирует 27.5 GiB таблицы в физической памяти (memlock unlimited в compose)
# НЕ добавлять: --mtp-attention-window (движок отказывается стартовать), --prefill-chunk 4096 и
# --prefill-cublas (забирают 1.3 GiB workspace => экспертный кэш -1.7 GiB, decode -13%), а также
# hybrid-флаги (--cache-taps-per-request, --cache-tap-ladder) — несовместимы с Checkpoint Catalog и --disk-kv-path.
# Ярусы кэша контекста для работы в 8 диалогах (Checkpoint Catalog: RAM Host tier 16 GiB + Disk tier 48 GiB):
# Ожидаемый пик ОЗУ ~104 GiB (RSS ~81 GiB на старте, available 44 GiB), диск до 48 GiB.
FLASH_NEXT_EXTRA_ARGS=--fast-prefill-kernel --adaptive-mtp --lm-head-q6 --embedding-q6 --gdn-state-fp16 --ngram-lock --max-private-continuations 8 --max-shared-prefixes 8 --auto-long-anchors --derive-session-keys --recency-eviction --disk-kv-path /workspace/logs/kv --disk-kv-gib 48 --disk-kv-restore --slot-save-path /workspace/logs/slots --auto-save-evicted

# --- Статистика и мониторинг ---
FLASH_NEXT_STATS_PORT=8081
MONITOR_ENABLED=true
MONITOR_PORT=8090
MONITOR_HOST_PORT=8091
MONITOR_INTERVAL=5
MONITOR_SAMPLES=4320
FLASH_NEXT_REQUEST_LOG=/workspace/logs/requests.jsonl
FLASH_NEXT_REQUEST_LOG_MIB=64
FLASH_NEXT_REQUEST_LOG_KEEP=4

# Host tier для контекстов НЕАКТИВНЫХ диалогов (pinned ОЗУ): состояния + KV-блоки.
# 16384 MiB хватает примерно на 3 диалога по ~100k токенов (1 диалог = 3.8 GiB KV + 1.77 GiB
# состояния). Остальные диалоги доживаются с дискового яруса (--disk-kv-path) за ~10 с.
# 0 вернул бы кэш целиком на устройство (там свободно 1.42 GiB) — не делать.
FLASH_NEXT_HOST_CACHE_MIB=16384

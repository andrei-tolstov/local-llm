# ==============================================================================
# Переменные окружения для запуска Qwen3.8-Flash-Next MoE (IQ3_S) на Tesla V100 32GB
# Репозиторий движка: https://github.com/JimmyMax/ninfer-v100
# Архитектура: Volta (sm_70), CUDA 12.8
# ==============================================================================

# Привязка адреса хоста (0.0.0.0 для локальной сети)
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте (8087)
FLASH_NEXT_PORT=8087

# Имя контейнера (для интеграции с llama-swap: flash-next-llama-server)
CONTAINER_NAME=flash-next-llama-server

# Идентификатор GPU для изоляции (Tesla V100 32GB)
# КРИТИЧЕСКИ ВАЖНО: Pascal GTX 1060 не должна быть доступна контейнеру
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325

# Путь к директории с моделью на хосте
FLASH_NEXT_MODELS_DIR=/opt/models/flash_next

# Файлы модели и companion n-gram таблицы
FLASH_NEXT_MODEL_FILE=Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-ninfer-v3.ninfer
FLASH_NEXT_NGRAM_FILE=Qwen3.8-Flash-Next-ngram-table-IQ4_NL-ninfer-v3.ninfer

# Имя модели для OpenAI API / OmniRoute / Llama-swap
FLASH_NEXT_ALIAS=qwen3.8-flash-next
FLASH_NEXT_API_KEY=

# ------------------------------------------------------------------------------
# Рекомендованные параметры JimmyMax/ninfer-v100:
# ------------------------------------------------------------------------------

# Логический потолок контекста (200000 токенов; или 32768 для увеличения кэша экспертов)
FLASH_NEXT_MAX_CONTEXT=200000

# Емкость KV кэша (auto выделяет оптимальный объем под контекст)
FLASH_NEXT_KV_CAPACITY=auto

# Квантование KV кэша и GDN recurrent state (rk4v4 экономит 1.2 GiB VRAM при расхождении всего +0.04% перплексии)
FLASH_NEXT_KV_DTYPE=rk4v4

# Режим хранения экспертов: disk (NVMe paging, рекомендуется для систем с <= 32GB RAM) или host (pinned RAM)
FLASH_NEXT_EXPERT_RESIDENCY=disk

# Размер кэша экспертов в VRAM (в MiB). Для disk residency на V100 32GB рекомендуется 18432 MiB (~5600 слотов экспертов)
FLASH_NEXT_EXPERT_CACHE_MIB=18432

# Чтение n-gram таблицы: ram (вся таблица 26.9 Гб в RAM), ram-hot (кэширование N MiB в RAM) или disk (с NVMe)
FLASH_NEXT_NGRAM_RESIDENCY=ram

# Объем RAM под горячие строки n-gram таблицы в режиме ram-hot (например, 20480 для 20 Гб; для ram пусто)
FLASH_NEXT_NGRAM_RAM_MIB=

# Блокировка страниц n-gram таблицы в физической памяти (mlock)
FLASH_NEXT_NGRAM_LOCK=true

# Размер хостового уровня KV-кэша контекста (в MiB). При 26.9 Гб n-gram в RAM ставим 0 (только GPU VRAM кэш)
FLASH_NEXT_HOST_CACHE_MIB=0

# Буферизация префилла (используется ТОЛЬКО для expert-residency=host; в режиме disk не поддерживается движком)
FLASH_NEXT_EXPERT_PREFILL_BUFFERS=

# Доля вычислений экспертов на GPU (1 = полностью GPU; расчет на CPU хоста медленнее шины PCIe 3.0)
FLASH_NEXT_EXPERT_DMA_SHARE=1

# Размер чанка префилла для Volta sm_70
FLASH_NEXT_PREFILL_CHUNK=2048

# Количество параллельных запросов
FLASH_NEXT_MAX_CONCURRENCY=1

# Спекулятивное декодирование MTP:
# В JimmyMax/ninfer-v100 для Flash-Next MoE на V100 финальный оптимум - 3 драфт-токена (43.5-44.0 tok/s, 62.5% acceptance)
FLASH_NEXT_SPEC_BACKEND=mtp
FLASH_NEXT_SPEC_DRAFT_TOKENS=3

# Отключение n-gram драфтов, предотвращающее размывание acceptance rate MTP
FLASH_NEXT_NGRAM_DRAFT_TOKENS=0

# Сохранение блока рассуждений (thinking tokens)
FLASH_NEXT_PRESERVE_THINKING=true

# Мультимодальность (Vision tower)
FLASH_NEXT_ENABLE_VISION=true

# Таймаут ожидания очереди/подготовки запроса (в мс): 20 минут = 1200000 мс
FLASH_NEXT_PENDING_TIMEOUT_MS=1200000

# Дополнительные аргументы командной строки ninfer-serve (если требуются)
FLASH_NEXT_EXTRA_ARGS=

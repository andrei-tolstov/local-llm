# syntax=docker/dockerfile:1.7
# ==============================================================================
# Движок: jmnargi/Strata-V100 — Strata для NVIDIA Volta (sm_70), Qwen3.8-Flash-Next
# https://github.com/jmnargi/Strata-V100  (форк Niko1221/Strata)
#
# Почему собирается здесь, а не берётся готовый образ:
#   1. Готовый движок Strata собран под AVX2. CPU хоста — Xeon E5-2650 v2
#      (Ivy Bridge-EP): флаги avx, f16c, sse4.2; AVX2 НЕТ. Готовый движок
#      падает с SIGILL (exit 132) — об этом прямо говорят апстримный
#      docker-entrypoint.sh и docs/INSTALL.md ("Older CPUs, experimental").
#      Лечится сборкой с -DSTRATA_ISA_FLOOR=avx.
#   2. Готовый образ апстрима собран на CUDA 13, а CUDA 13 не компилирует
#      sm_70 (docs/OLDER_GPUS.md: "CUDA 13 dropped Pascal and Volta").
#      Для V100 нужен CUDA 12.x + -DSTRATA_EXPERIMENTAL_SM60=ON.
#   3. Драйвер хоста 550.163.01 (нативно CUDA 12.4). Для CUDA 12.x довольно
#      драйвера 525+, cuda-compat не требуется.
# ==============================================================================

ARG CUDA_VERSION=12.8.0
ARG UBUNTU_VERSION=24.04
ARG STRATA_REF=v0.1.45.12

# ---------- builder: движок strata и, опционально, strata-vision ----------
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS builder

ARG STRATA_REF
ARG CUDA_ARCHITECTURES=70
ARG STRATA_ISA_FLOOR=avx
ARG STRATA_EXPERIMENTAL_SM60=ON
ARG BUILD_VISION=0

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8

# cmake и ninja ставятся в образ явно: setup.cmake_build их ищет и падает,
# если их нет (requirements-build.txt в .venv — запасной путь апстрима).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git ca-certificates curl unzip \
        python3 python3-pip python3-venv libatomic1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
RUN git clone --depth 1 --branch ${STRATA_REF} https://github.com/jmnargi/Strata-V100.git .

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh docker-entrypoint.sh

# Сборка повторяет апстримный Dockerfile (тот же setup.cmake_build и BUILD.json,
# чтобы setup.py признал движок своим и не перекомпилировал его при старте),
# но с флагами Volta и AVX-пола.
RUN .venv/bin/python - <<'PYEOF'
import json, os, pathlib, shutil
import setup

llama = setup.get_llama_cpp()
nvcc, _ = setup.find_nvcc()
arch = os.environ.get("CUDA_ARCHITECTURES", "70").strip().strip('"').replace(",", ";")
isa = os.environ.get("STRATA_ISA_FLOOR", "avx").strip()
sm60 = os.environ.get("STRATA_EXPERIMENTAL_SM60", "ON").strip()
vision = "gpu" if os.environ.get("BUILD_VISION", "0") == "1" else "none"

common = ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF",
          "-DCMAKE_CUDA_ARCHITECTURES=" + arch, "-DCMAKE_CUDA_COMPILER=" + nvcc,
          "-DSTRATA_EXPERIMENTAL_SM60=" + sm60]
if isa:
    common.append("-DSTRATA_ISA_FLOOR=" + isa)

setup.cmake_build(setup.ROOT, setup.ROOT / "build", "strata",
                  common + ["-DSTRATA_GGML_DIR=" + str(llama)], None, "build-strata.bat")
if vision != "none":
    setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision", "strata-vision",
                      ["-DLLAMA_DIR=" + str(llama), "-DSTRATA_VISION_CUDA=ON", "-DSTRATA_PORTABLE=OFF",
                       "-DCMAKE_CUDA_ARCHITECTURES=" + arch, "-DCMAKE_CUDA_COMPILER=" + nvcc],
                      None, "build-vision.bat")

eng = setup.ROOT / "engine"
eng.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build" / setup.EXE, eng / setup.EXE)
if vision != "none":
    shutil.copy2(setup.ROOT / "build-vision" / "bin" / setup.VEXE, eng / setup.VEXE)

bindir = pathlib.Path(nvcc).parent
meta = {"source": "local", "version": setup.source_version(),
        "archs": [int(a.split("-")[0]) for a in arch.split(";") if a.split("-")[0].isdigit()],
        "vision": vision,
        "cuda_dirs": [str(d) for d in (bindir, bindir / "x64", bindir.parent / "lib64") if d.is_dir()],
        "src": setup.source_hash(setup.ENGINE_SOURCES),
        "vision_src": setup.source_hash(setup.VISION_SOURCES) if vision != "none" else None}
(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))
print("engine:", meta["version"], "archs:", meta["archs"], "vision:", vision, "isa_floor:", isa)
PYEOF

# cmake-деревья нужны только на сборке
RUN rm -rf build build-vision

# ---------- runtime ----------
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv curl ca-certificates libatomic1 libgomp1 libcurl4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY --from=builder /opt/strata /opt/strata

# STRATA_EXECV=1: setup.py заменяет себя процессом сервера, поэтому сервер
# становится PID 1 и SIGTERM от docker stop доходит до него.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    STRATA_DATA=/data \
    STRATA_EXECV=1 \
    PORT=8080

VOLUME ["/data"]
EXPOSE 8080

# Модель грузится 1-3 минуты (первый старт — ещё и распаковка пакета), поэтому
# start_period большой: короткий помечает контейнер unhealthy, и restart
# политика убьёт загрузку на середине.
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
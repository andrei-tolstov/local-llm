# ==============================================================================
# Переменные окружения движка Strata (jmnargi/Strata-V100) для Qwen3.8-Flash-Next
# Целевой хост: 1x NVIDIA Tesla V100-PCIE-32GB (sm_70), CUDA 12.8, драйвер 550.163.01
# ==============================================================================
#
# ------------------------ ЗАМЕРЫ ЖЕЛЕЗА ХОСТА (2026-11-20) --------------------
# GPU0  Tesla V100-PCIE-32GB  UUID GPU-733ae7cc-c1bf-3352-42d5-ba2762470325  sm_70
# GPU1  GeForce GTX 1060 3GB  UUID GPU-7b86aac7-cea5-5401-ceb0-463b5df668b1  sm_61
#       -> контейнеру НЕ отдаётся: движок собран под sm_70, карта ниже Volta.
# CPU   Intel Xeon E5-2650 v2 (Ivy Bridge-EP), 8 ядер / 8 потоков
#       флаги: avx, f16c, sse4.2 — AVX2 ОТСУТСТВУЕТ.
#       Поэтому движок собирается с -DSTRATA_ISA_FLOOR=avx; готовые сборки
#       Strata (AVX2) на этом CPU падают с SIGILL (exit 132).
# RAM   62.74 GiB всего. С запущенным ninfer-профилем flash-next занято 58.56 GiB
#       (93%), остальные контейнеры ~0.35 GiB. Движки переключаются по одному.
# ДИСК  / = 433G, свободно ~80G. Это узкое место Strata: пакет IQ3_S качается
#       83.6 GB, IQ2_XS 68.0 GB, Q2_0 66.4 GB (+ распаковка пакета Strata).
#       Перед скачиванием освободить место; проверить: df -h /
# ==============================================================================

# Привязка адреса хоста
HOST_BIND_IP=0.0.0.0

# Порт сервиса на хосте. Ряд занят: 8087 — ninfer-профиль flash-next, 8088 — qwen-image
# (в llama-swap). Поэтому взят 8089; в systemd-сервисе форка тот же движок слушает 8088.
STRATA_PORT=8089

# Имя контейнера (совпадает с алиасом llama-swap: <имя>-llama-server)
CONTAINER_NAME=flash-next-strata-llama-server

# GPU только V100
TARGET_GPU_UUID=GPU-733ae7cc-c1bf-3352-42d5-ba2762470325
STRATA_GPU_INDEX=0

# Каталоги хоста: GGUF-и и рабочие данные движка (пакет, MTP-слой, конфиг)
STRATA_MODELS_DIR=/opt/models/flash-next-strata
STRATA_DATA_DIR=/opt/models/flash-next-strata/data
GGUF_DIR=/models

# Версия движка форка для сборки образа (релиз со сборкой sm_70 / CUDA 12)
STRATA_REF=v0.1.45.12

# Имя модели для OpenAI API
STRATA_API_KEY=

# ------------------------------------------------------------------------------
# Выбор пакета модели (скачивается download_model_strata.sh, см. размеры ниже)
# ------------------------------------------------------------------------------
FAMILY=qwen
# IQ2_XS  : скачивание 68.0 GB, арена экспертов 35.5 GB, нужно ~48 GB RAM.
#           На этом хосте 262144 токенов помещается целиком — дефолт.
# IQ3_S   : скачивание 83.6 GB, арена 50.3 GB, нужно ~62 GB RAM — качество
#           полной модели, но на 62.74 GiB RAM впритык и не влезает на диск (80 GB).
#           Для него: MODEL=IQ3_S, LOW_RAM=resident (при off контекст длиннее 131072 недоступен).
# Q2_0    : скачивание 66.4 GB, арена 34.0 GB — максимум скорости, ниже качество.
MODEL=IQ2_XS

# --------------------------- МАКСИМАЛЬНЫЙ КОНТЕКСТ ----------------------------
# 262144 токенов — длина, на которой модель обучена (rotary base 1e7). Это
# потолок без экспериментальных расширений; Strata отказывает запросам длиннее,
# а не обрезает их молча. Для сравнения: ninfer-профиль работает на 200000.
# 393216 / 524288 возможны только через rope scaling (yarn, коэффициент
# = контекст / 262144) и в доках форка помечены EXPERIMENTAL; docker-entrypoint.sh
# этих флагов не передаёт, поэтому такой контекст настраивается вручную через
# setup.py --context 524288 --rope-scaling yarn.
CONTEXT=262144

# KV кэш: int8 = 1056 байт на токен контекста (12 слоёв QSA + MTP-блок).
# 262144 токенов => 276 MiB. Дешевле всего k8v4 (-23%), но на гибридной
# архитектуре Flash-Next KV не является узким местом, поэтому оставлен int8.
KV=int8
# Стриминг KV: в VRAM живёт только окно, которое реально читает внимание,
# остальное в RAM (~13.7 KB на токен => 3.6 GiB на 262144). Освобожденную VRAM
# движок отдаёт кэшу экспертов (STRATA_KV_GROW=1 ниже).
KV_STREAMING=on
# Размер постоянного окна KV в VRAM (--kv-resident 32768) задаётся внутри
# /data/config/strata-iq2_xs.json в engine_args: docker-entrypoint.sh этой
# переменной окружения не читает.

# Три яруса памяти движка — то же, что в ninfer-профиле, только другими именами:
#   VRAM  кэш экспертов (--expert-cache auto, размер считает сам из свободной VRAM);
#   RAM   эксперты, которые не поместились в VRAM;
#   NVMe  n-gram (PLE) таблица, читается прямо с диска (--ple-io, см. ниже).
# off      = арена экспертов целиком копируется в RAM (быстрее; у IQ2_XS 35.5 GB влезает);
# resident = --resident-experts: не вошедшие в VRAM эксперты копируются в RAM один раз;
# on/mmap  = --mmap-experts: они читаются через page cache с NVMe;
# auto     = решает setup (на этом хосте и для IQ2_XS, и для IQ3_S выходит off).
# Важно для IQ3_S: при off правило RAM (арена + KV + 24 GB) не даёт взять контекст
# больше 131072. Нужен именно resident: в VRAM ~23.9 GB экспертов, остальные ~26.5 GB
# в RAM — правило resident: RAM >= арена минус VRAM-кэш плюс 10 GB запаса.
LOW_RAM=off

# К нашим пакетам НЕ применяется: --resident-budget-gib движок использует для
# Unsloth-файлов UD-Q4_K_XL / UD-IQ4_XS и NVFP4-пакетов. Для GSQ-RCO вместо него
# служит LOW_RAM=resident (или on).
RESIDENT_BUDGET_GIB=

# n-gram (PLE) таблица 28.8 GB лежит на диске по умолчанию: движок читает её
# небуферизованно мимо кэша ОС (--ple-io direct, строки IQ4_NL по 90 байт) —
# отдельного переключения ярус "таблица на NVMe" не требует. Вариант --ple-io ram
# держит её в RAM и требует арена + 28.8 GB + 16 GB запаса (для IQ3_S ~95 GB),
# чего на этом хосте нет, поэтому setup его не включает. Если прямые чтения окажутся
# медленнее 15K строк/с, можно вернуть переключение на mmap:
# STRATA_PLE_AUTO_MMAP=1
# Диск хоста: NVMe Samsung 970 EVO Plus, /sys/block/.../queue/rotational = 0.


# Vision: по умолчанию выключен. Энкодер держит ~1.74 GiB VRAM постоянно;
# для картинок поставить BUILD_VISION=1 (пересборка образа) и VISION=yes.
BUILD_VISION=0
VISION=no

# ------------------------ профиль Tesla V100 из доков форка -------------------
# service/strata-v100.service.d форка (90-cpu-prefill, 95-v0141-profile,
# 96-prefill-performance, 97-resident-routing, 98-verify-ecap). Оставлено то, что
# относится к одной карте; опции разноса слоёв (STRATA_SPLIT_*) убраны.
STRATA_ARENA_LOCK=0
STRATA_WATCHDOG_S=300
STRATA_SM70_TABLE=1
STRATA_DEQUANT_WIDE=1
STRATA_PF_WMMA=1
STRATA_PF_SKIP_UNROUTED=1
STRATA_KV_GROW=1
STRATA_CKPT_POOL=1
STRATA_CKPT_THREADS=1
STRATA_PREFILL_PROMOTE=2048
STRATA_SELECT_SIMT=1

# CPU-помощь в префилле: на 8 потоках Ivy Bridge выключена (0), иначе отнимает
# потоки у AVX-1 декодирования. В форке по умолчанию auto — вернуть можно так:
# STRATA_PREFILL_CPU_SHARE=auto
STRATA_PREFILL_CPU_SHARE=0
STRATA_PREFILL_STREAM_MIN=6144
STRATA_PREFILL_CPU_SHARE_MAX=6144
STRATA_PREFILL_LOAN_EXACT=1

# Опции форка, которые МЕНЯЮТ ответы модели (на паре V100 включены, здесь нет):
# STRATA_ROUTE_RESIDENT=1   # маршрутизация с уклоном в резидентность экспертов
# STRATA_VERIFY_ECAP=16     # потолок набора экспертов в окне проверки, +~11% decode
# STRATA_PF_WMMA_LEAN=1     # отказ от MMQ-буферов промпта: +4% на 8K, минус на коротких

# -------------------------------------------------------------
# Доп. аргументы движка задаются в engine_args внутри
# /data/config/strata-<model>.json, а не через переменные окружения:
# docker-entrypoint.sh понимает только FAMILY, MODEL, CONTEXT, VISION, KV,
# KV_STREAMING, LOW_RAM, GPU/GPUS/LAYER_SPLIT, GGUF_DIR, RESIDENT_BUDGET_GIB,
# HOST, PORT, API_KEY, CONFIG и REINSTALL.
# Пример engine_args для этого хоста (MTP-декодирование, окно KV в VRAM):
#   ["--mtp", "--spec", "4", "--kv-resident", "32768", "--vram-reserve-mib", "512"]
# форк измерял на V100 --mtp --spec 4 и --spec 8.
CONFIG=
# 1 = пересобрать установку модели (смена CONTEXT / KV / пакета). Обычный старт
# настройки не трогает.
REINSTALL=0

# syntax=docker/dockerfile:1.7
# ==============================================================================
# Специализированный образ NInfer под архитектуру Volta sm_70 (Tesla V100 32GB)
# и процессор Intel Xeon E5-2650 v2 (без AVX2, набор AVX 1.0 + F16C)
# Движок: https://github.com/andrei-tolstov/ninfer-v100
# В образ кладётся и сайдкар мониторинга tools/monitor из той же ветки — версии
# движка и монитора совпадают по построению.
# ==============================================================================

ARG CUDA_VERSION=12.8.0
ARG UBUNTU_VERSION=24.04
ARG REPO_URL=https://github.com/andrei-tolstov/ninfer-v100.git
ARG BRANCH=main

# --- Этап сборки (Builder) ---
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG REPO_URL
ARG BRANCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    cmake \
    ninja-build \
    pkg-config \
    libavformat-dev \
    libavcodec-dev \
    libavutil-dev \
    libswscale-dev \
    libcurl4-openssl-dev \
    python3 \
    python3-dev \
    python-is-python3 \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Клонирование форка с поддержкой E5-2650v2 AVX
RUN git clone --depth 1 --branch ${BRANCH} ${REPO_URL} /workspace/src

WORKDIR /workspace/src

# Сборка ninfer-serve с явным отключением AVX2/FMA для ggml (-DNINFER_GGML_CPU_AVX2=OFF) и таргетом sm_70
# python3 указан явно: его требует cmake CUTLASS, который тянется через FetchContent
RUN cmake -S . -B /workspace/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=70 \
        -DNINFER_GGML_CPU_AVX2=OFF \
        -DNINFER_BUILD_APPS=ON \
        -DBUILD_TESTING=OFF \
        -DNINFER_BUILD_BENCHMARKS=OFF \
        -DPython3_EXECUTABLE=/usr/bin/python3 \
    && cmake --build /workspace/build --parallel $(nproc) --target ninfer-serve

# --- Этап выполнения (Runtime) ---
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    libavformat60 \
    libavcodec60 \
    libavutil58 \
    libswscale7 \
    libcurl4 \
    libgomp1 \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY --from=builder /workspace/build/apps/ninfer-serve /usr/local/bin/ninfer-serve
RUN chmod +x /usr/local/bin/ninfer-serve

# Сайдкар мониторинга из той же ветки движка (stdlib-only, python3 выше)
COPY --from=builder /workspace/src/tools/monitor/monitor.py /opt/ninfer-monitor/monitor.py
COPY --from=builder /workspace/src/tools/monitor/watchdog.py /opt/ninfer-monitor/watchdog.py

# Скрипт запуска: сервер + монитор (аргументы задаёт docker-compose)
COPY launch.sh /usr/local/bin/ninfer-launch.sh
RUN chmod +x /usr/local/bin/ninfer-launch.sh /opt/ninfer-monitor/*.py

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NINFER_HOST=0.0.0.0 \
    NINFER_PORT=8080

EXPOSE 8080 8090
STOPSIGNAL SIGTERM

CMD ["ninfer-serve", "--help"]
